datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String // "ADMIN", "DOCTOR", "STUDENT"
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  status    String   @default("ACTIVE") // "ACTIVE", "INACTIVE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  doctorProfile  DoctorProfile?
  notifications  Notification[]
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  doctorId       String   @unique // e.g. "DOC-MED-01"
  specialization String // e.g. "General Medicine"
  qualification  String // e.g. "MBBS, MD"
  experience     Int      @default(0) // years
  department     String   @default("LNMIIT Medical Centre")
  availableDays  String?  @default("Mon - Sat")
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStudents StudentProfile[]
  sessions         MonitoringSession[]
  clinicalNotes    ClinicalNote[]
  prescriptions    Prescription[]
}

model DoctorSpecialization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model StudentProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  rollNumber            String    @unique // e.g. "21UEC045"
  branch                String // e.g. "Electronics & Communication"
  yearOfStudy           Int // 1, 2, 3, 4
  dateOfBirth           DateTime?
  age                   Int?      @default(20)
  gender                String?   @default("Not Specified")
  bloodGroup            String?   @default("B+")
  emergencyContactName  String?
  emergencyContactPhone String?
  allergies             String?   @default("None reported")
  chronicConditions     String?   @default("None reported")
  hostelRoom            String?   @default("BH-1 Room 102")
  assignedDoctorId      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedDoctor  DoctorProfile?      @relation(fields: [assignedDoctorId], references: [id])
  sessions        MonitoringSession[]
  vitals          VitalsReading[]
  clinicalNotes   ClinicalNote[]
  prescriptions   Prescription[]
  medicalReports  MedicalReport[]
  healthBaselines HealthBaseline[]
}

model Device {
  id              String   @id @default(uuid())
  deviceId        String   @unique // "ESP32_BED_1", "ESP32_BED_2", "RPI_EDGE_01", "NLP_SERVICE"
  name            String
  type            String // "ESP32_SENSOR", "EDGE_GATEWAY", "AI_SERVICE"
  bedNumber       Int?
  macAddress      String?
  ipAddress       String?
  status          String   @default("ONLINE") // "ONLINE", "OFFLINE", "CONNECTING"
  isRealHardware  Boolean  @default(false) // true = real hardware, false = demo simulator
  lastSeen        DateTime @default(now())
  firmwareVersion String?  @default("v1.2.4-lnmiit")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions MonitoringSession[]
  vitals   VitalsReading[]
}

model MonitoringSession {
  id               String    @id @default(uuid())
  bedNumber        Int // 1 or 2
  studentId        String
  doctorId         String
  deviceId         String?
  startTime        DateTime  @default(now())
  endTime          DateTime?
  durationMinutes  Int?
  status           String    @default("ACTIVE") // "ACTIVE", "COMPLETED", "TERMINATED"
  chiefComplaint   String?
  initialRiskLevel String    @default("NORMAL")
  peakRiskLevel    String    @default("NORMAL")
  finalRiskLevel   String    @default("NORMAL")
  summary          String?
  avgHeartRate     Float?
  avgSpo2          Float?
  avgTemperature   Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student       StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  device        Device?         @relation(fields: [deviceId], references: [id])
  vitals        VitalsReading[]
  riskEvents    RiskEvent[]
  clinicalNotes ClinicalNote[]
  prescriptions Prescription[]
}

model VitalsReading {
  id                 String   @id @default(uuid())
  sessionId          String?
  studentId          String?
  bedNumber          Int
  deviceId           String?
  heartRate          Float? // Optional legacy BPM
  spo2               Float? // Optional legacy SpO2 %
  temperature        Float // LM35 / Temp Sensor Celsius
  ultrasonicDistance Float? // Ultrasonic HC-SR04 distance in cm
  force              Float? // Force / pressure sensor reading (N)
  riskLevel          String   @default("NORMAL") // "NORMAL", "MONITOR", "ATTENTION", "EMERGENCY"
  riskScore          Float    @default(0) // 0 to 100
  riskExplanation    String?
  isEmergency        Boolean  @default(false)
  source             String   @default("SIMULATOR") // "HARDWARE" or "SIMULATOR"
  timestamp          DateTime @default(now())

  session MonitoringSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  device  Device?            @relation(fields: [deviceId], references: [id])
}

model HealthBaseline {
  id                    String   @id @default(uuid())
  studentId             String   @unique
  baselineHeartRate     Float    @default(72.0)
  baselineSpo2          Float    @default(98.0)
  baselineTemperature   Float    @default(36.8)
  totalSessionsRecorded Int      @default(0)
  updatedAt             DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model RiskEvent {
  id             String    @id @default(uuid())
  sessionId      String?
  studentId      String
  bedNumber      Int
  riskLevel      String // "ATTENTION", "EMERGENCY"
  riskScore      Float
  title          String
  explanation    String
  vitalsSnapshot String // JSON string e.g. {"heartRate":156,"spo2":88.5,"temperature":39.8}
  isAcknowledged Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  session MonitoringSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ClinicalNote {
  id                     String   @id @default(uuid())
  studentId              String
  doctorId               String
  sessionId              String?
  chiefComplaint         String
  clinicalObservations   String
  diagnosis              String?
  instructions           String
  followUpRecommendation String?
  isSharedWithStudent    Boolean  @default(true)
  createdAt              DateTime @default(now())

  student StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  session MonitoringSession? @relation(fields: [sessionId], references: [id])
}

model Prescription {
  id        String   @id @default(uuid())
  studentId String
  doctorId  String
  sessionId String?
  diagnosis String?
  notes     String?
  status    String   @default("ACTIVE") // "ACTIVE", "COMPLETED", "CANCELLED"
  createdAt DateTime @default(now())

  student StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  session MonitoringSession? @relation(fields: [sessionId], references: [id])
  items   PrescriptionItem[]
}

model PrescriptionItem {
  id             String @id @default(uuid())
  prescriptionId String
  medicineName   String
  dosage         String // e.g. "500 mg"
  frequency      String // e.g. "Twice daily after meals"
  duration       String // e.g. "3 days"
  instructions   String // e.g. "Take with plenty of warm water"

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model MedicalReport {
  id            String   @id @default(uuid())
  studentId     String
  title         String
  fileName      String
  filePath      String
  fileSize      Int
  mimeType      String   @default("application/pdf")
  extractedText String?
  uploadDate    DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  summary ReportSummary?
}

model ReportSummary {
  id                   String   @id @default(uuid())
  reportId             String   @unique
  keyFindings          String
  abnormalValues       String
  possibleConcerns     String
  questionsToAskDoctor String
  serviceStatus        String   @default("FALLBACK_ENGINE") // "NLP_SERVICE" or "FALLBACK_ENGINE"
  disclaimer           String   @default("AI-generated summary. This is not a medical diagnosis. Please consult a qualified doctor for interpretation.")
  generatedAt          DateTime @default(now())

  report MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String // "EMERGENCY", "ATTENTION", "SESSION", "PRESCRIPTION", "NOTE", "REPORT", "DEVICE"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
